{
  "name": "loadhunter-landing",
  "private": true,
  "version": "1.0.0",
  "description": "Marketing landing page for the LoadHunter browser extension — a pixel-perfect implementation of the Figma design (1920px canvas) with GSAP scroll animations, Lenis smooth scrolling and an interactive pricing calculator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "transcode": "node scripts/transcode-images.mjs",
    "prebuild": "node scripts/transcode-images.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shaders": "^3.0.436",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
